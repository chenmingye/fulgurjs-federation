+)
+onMounted(() => { historyLen.value = window.history.length })
+
+function handleReady(): void {
+  mountCount.value++
+}
+</script>
+
+<style scoped>
+.fed-bridge-container { border: 1px dashed #fa8c16; border-radius: 6px; padding: 8px; min-height: 480px; }
