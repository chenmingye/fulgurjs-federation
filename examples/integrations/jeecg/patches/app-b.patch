+
+const state = reactive<JeecgBridgeProps>({})
+
+export function setBridgeProps(props: JeecgBridgeProps | undefined): void {
+  Object.assign(state, props ?? {})
+}
+
+export function useBridgeProps(): Readonly<JeecgBridgeProps> {
+  return state
+}
