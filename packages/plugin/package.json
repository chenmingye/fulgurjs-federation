{
  "name": "@fulgur/federation",
  "version": "0.2.0",
  "type": "module",
  "description": "Vite Module Federation with full Webpack MF parity. Dev & production, no compromise.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/runtime/index.ts --bundle --format=esm --target=es2022 --minify --outfile=dist/runtime.js && node scripts/gen-runtime.mjs && tsup src/index.ts --format esm,cjs --dts --external vite --target node18 --clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "es-module-lexer": "^1.6.0",
    "magic-string": "^0.30.17"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenmingye/fulgur-federation.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/chenmingye/fulgur-federation#readme",
  "author": "chenmingye (Jason)",
  "bugs": {
    "url": "https://github.com/chenmingye/fulgur-federation/issues"
  },
  "keywords": [
    "vite",
    "module-federation",
    "federation",
    "micro-frontend",
    "vite-plugin",
    "webpack-federation"
  ],
  "engines": {
    "node": ">=18"
  }
}