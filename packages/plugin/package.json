{
  "name": "@fulgurjs/federation",
  "version": "6.1.0",
  "type": "module",
  "description": "Vite Module Federation for Vue and React: remote modules, shared dependencies and app bridges.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./runtime": {
      "types": "./dist/runtime-entry.d.ts",
      "import": "./dist/runtime-entry.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json",
    "./internal/context.js": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./internal/pages.js": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages.js",
      "require": "./dist/pages.cjs"
    },
    "./internal/vue-adapter.js": {
      "types": "./dist/vue-adapter.d.ts",
      "import": "./dist/vue-adapter.js",
      "require": "./dist/vue-adapter.cjs"
    },
    "./internal/react-adapter.js": {
      "types": "./dist/react-adapter.d.ts",
      "import": "./dist/react-adapter.js",
      "require": "./dist/react-adapter.cjs"
    },
    "./internal/bridge-core.js": {
      "types": "./dist/bridge-core.d.ts",
      "import": "./dist/bridge-core.js"
    },
    "./internal/bridge-app-vue.js": {
      "types": "./dist/bridge-app-vue.d.ts",
      "import": "./dist/bridge-app-vue.js"
    },
    "./internal/bridge-app-react.js": {
      "types": "./dist/bridge-app-react.d.ts",
      "import": "./dist/bridge-app-react.js"
    },
    "./internal/bridge-host-vue.js": {
      "types": "./dist/bridge-host-vue.d.ts",
      "import": "./dist/bridge-host-vue.js"
    },
    "./internal/bridge-host-react.js": {
      "types": "./dist/bridge-host-react.d.ts",
      "import": "./dist/bridge-host-react.js"
    },
    "./internal/bridge-router-core.js": {
      "types": "./dist/bridge-router-core.d.ts",
      "import": "./dist/bridge-router-core.js"
    },
    "./internal/bridge-router-vue.js": {
      "types": "./dist/bridge-router-vue.d.ts",
      "import": "./dist/bridge-router-vue.js"
    },
    "./internal/bridge-router-react.js": {
      "types": "./dist/bridge-router-react.d.ts",
      "import": "./dist/bridge-router-react.js"
    }
  },
  "typesVersions": {
    "*": {
      "vue": [
        "dist/vue.d.ts"
      ],
      "runtime": [
        "dist/runtime-entry.d.ts"
      ],
      "react": [
        "dist/react.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "DESIGN.md",
    "examples",
    "docs/zh/reference/api.md",
    "docs/zh/reference/errors.md",
    "docs/zh/migration.md",
    "docs/en/reference/api.md",
    "docs/en/reference/errors.md",
    "docs/en/migration.md",
    "docs/maintainers/webpack-mf-对照与缺口.md",
    "docs/maintainers/沙箱边界审计.md",
    "docs/maintainers/P5-vite7-8兼容矩阵.md"
  ],
  "scripts": {
    "build": "cp ../../README.md README.md && cp ../../README.en.md README.en.md && mkdir -p docs && mkdir -p docs/zh/reference docs/en/reference docs/maintainers && cp ../../docs/zh/reference/api.md ../../docs/zh/reference/errors.md docs/zh/reference/ && cp ../../docs/zh/migration.md docs/zh/ && cp ../../docs/en/reference/api.md ../../docs/en/reference/errors.md docs/en/reference/ && cp ../../docs/en/migration.md docs/en/ && cp ../../docs/maintainers/webpack-mf-对照与缺口.md ../../docs/maintainers/沙箱边界审计.md ../../docs/maintainers/P5-vite7-8兼容矩阵.md docs/maintainers/ && cp ../../CHANGELOG.md CHANGELOG.md && cp ../../DESIGN.md DESIGN.md && node scripts/sync-package-examples.mjs && esbuild src/runtime/index.ts --bundle --format=esm --target=es2022 --minify --outfile=dist/runtime.js && node scripts/gen-runtime.mjs && tsup src/index.ts src/pages.ts src/vue-adapter.ts src/react-adapter.ts src/context.ts src/bridge-core.ts src/bridge-errors.ts src/bridge-app-vue.ts src/bridge-app-react.ts src/bridge-host-vue.ts src/bridge-host-react.ts --format esm,cjs --dts --external vite --target node18 --clean && tsup src/runtime-entry.ts --format esm --dts --external vite --target node18 && tsup src/vue.ts --format esm --dts --external vite,vue,vue-router --target node18 && tsup src/react.ts --format esm --dts --external vite,react,react-dom,react-router-dom --target node18 && tsup src/bridge-router-vue.ts --format esm --dts --external vite,vue,vue-router --target node18 && tsup src/bridge-router-react.tsx --format esm --dts --external vite,react,react-dom,react-router-dom --target node18 && esbuild src/cli.ts --bundle --format=esm --target=node18 --platform=node --outfile=dist/cli.js && esbuild src/runtime/index.ts --bundle --format=esm --target=es2022 --minify --outfile=dist/runtime.js && node scripts/gen-runtime-entry.mjs && node scripts/check-gzip.mjs && node scripts/check-manual-codes.mjs",
    "dev": "tsup --watch",
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit",
    "typecheck:latest": "node scripts/typecheck-latest.mjs"
  },
  "dependencies": {
    "es-module-lexer": "^1.6.0",
    "esbuild": "^0.27.0",
    "magic-string": "^0.30.17"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^24.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4",
    "react-router-dom": "^7.18.4"
  },
  "peerDependencies": {
    "vite": ">=5.1.0",
    "vue": ">=3.2.0",
    "react": ">=18.0.0 <20",
    "react-dom": ">=18.0.0 <20",
    "vue-router": ">=4.1.0 <6",
    "react-router-dom": ">=6.11.0 <8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenmingye/fulgurjs-federation.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/chenmingye/fulgurjs-federation#readme",
  "author": "chenmingye (Jason)",
  "bugs": {
    "url": "https://github.com/chenmingye/fulgurjs-federation/issues"
  },
  "keywords": [
    "vite",
    "module-federation",
    "federation",
    "micro-frontend",
    "vite-plugin",
    "webpack-federation"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "fulgurjs": "./dist/cli.js"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  }
}
