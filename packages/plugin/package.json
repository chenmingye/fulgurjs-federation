{
  "name": "@fulgurjs/federation",
  "version": "0.9.1-test.0",
  "type": "module",
  "description": "Vite Module Federation with full Webpack MF parity. Dev & production, no compromise.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages.js",
      "require": "./dist/pages.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "pages": [
        "dist/pages.d.ts"
      ],
      "config": [
        "dist/config.d.ts"
      ],
      "vue": [
        "dist/vue.d.ts"
      ],
      "context": [
        "dist/context.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "client.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "DESIGN.md",
    "examples",
    "docs/\u8fc1\u79fb\u6307\u5357.md",
    "docs/webpack-mf-\u5bf9\u7167\u4e0e\u7f3a\u53e3.md",
    "docs/\u6c99\u7bb1\u8fb9\u754c\u5ba1\u8ba1.md",
    "docs/P5-vite7-8\u517c\u5bb9\u77e9\u9635.md",
    "docs/vite-upstream-issue-irregexp.md"
  ],
  "scripts": {
    "build": "cp ../../README.md README.md && mkdir -p docs && cp ../../docs/\u8fc1\u79fb\u6307\u5357.md ../../docs/webpack-mf-\u5bf9\u7167\u4e0e\u7f3a\u53e3.md ../../docs/\u6c99\u7bb1\u8fb9\u754c\u5ba1\u8ba1.md ../../docs/P5-vite7-8\u517c\u5bb9\u77e9\u9635.md ../../docs/vite-upstream-issue-irregexp.md docs/ && cp ../../CHANGELOG.md CHANGELOG.md && cp ../../DESIGN.md DESIGN.md && rm -rf examples && cp -r ../../examples examples && esbuild src/runtime/index.ts --bundle --format=esm --target=es2022 --minify --outfile=dist/runtime.js && node scripts/gen-runtime.mjs && tsup src/index.ts src/pages.ts src/config.ts src/vue.ts src/context.ts --format esm,cjs --dts --external vite --target node18 --clean && esbuild src/cli.ts --bundle --format=esm --target=node18 --platform=node --outfile=dist/cli.js && esbuild src/runtime/index.ts --bundle --format=esm --target=es2022 --minify --outfile=dist/runtime.js && node scripts/check-gzip.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:latest": "node scripts/typecheck-latest.mjs"
  },
  "dependencies": {
    "es-module-lexer": "^1.6.0",
    "magic-string": "^0.30.17"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "vue": "^3.5.22"
  },
  "peerDependencies": {
    "vite": ">=5.0.0",
    "vue": ">=3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenmingye/fulgurjs-federation.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/chenmingye/fulgurjs-federation#readme",
  "author": "chenmingye (Jason)",
  "bugs": {
    "url": "https://github.com/chenmingye/fulgurjs-federation/issues"
  },
  "keywords": [
    "vite",
    "module-federation",
    "federation",
    "micro-frontend",
    "vite-plugin",
    "webpack-federation"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "fulgurjs": "./dist/cli.js"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
