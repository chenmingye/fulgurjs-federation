# dependencies
node_modules/

# build output
packages/plugin/dist/
fixtures/*/dist/
fixtures/*/dist-*/
examples/**/dist/
examples/**/src/fulgurjs/types/
# fixtures 无 tsconfig，插件 dev 启动生成的类型目录（每次运行重生成）不入库
fixtures/*/src/fulgurjs/types/

# testbed（真实项目私有副本，7.6G，不入库——发 GitHub 时同样排除）
testbed/

# test & tooling artifacts
e2e/artifacts/
e2e/playwright-report/
e2e/test-results/
e2e/.prod-dist/
e2e/.playwright/
*.log

# editor / OS
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# local env
.env.local
.env.*.local

# 所有测试截图与业务截图仅保留本地，不纳入公开 Git 仓库
docs/screenshots/
e2e/**/screenshots/
fixtures/**/screenshots/
# 项目本地工作区（不入库：验证产物/截图/工作记录）
docs/_workspace/
docs/func-results/
docs/playwright-report/

# 项目本地验证脚本（不入库；fixtures e2e 与 h7 装后实测除外）
e2e/*.mjs
e2e/h3-audit.sh
e2e/nginx/30-fulgur-test-8662.conf
packages/plugin/README.md
packages/plugin/README.en.md
packages/plugin/docs/
packages/plugin/CHANGELOG.md
packages/plugin/DESIGN.md
packages/plugin/examples

# npm pack 产物
packages/plugin/*.tgz
.typecheck-latest/

# e2e prod 隔离实例状态（prod-setup.sh 写入）
e2e/.prod-port
e2e/.prod-nginx.json

# React fixtures 类型检查探针（R15 脚本生成，不入库）
fixtures/host-react/typecheck/

# 仓库根严禁 pnpm-lock.yaml（会劫持全树 pnpm 安装；stray pnpm install 会生成——不入库）
/pnpm-lock.yaml

# Demo 展示中心：Jeecg 上游基线体积巨大不入库（fetch-upstream.sh + patches 可复现）；
# 改造后的演示实例源码（app-a/app-b）自 2026-10-03 起入库交付（node_modules/dist 由全局规则排除）
demo/jeecg/upstream/
demo/.run/
demo/**/dist/
demo/**/src/fulgurjs/types/
# Jeecg 实例的本地缓存/构建副产物（双保险，防止上游 .gitignore 差异漏网）
demo/jeecg/app-a/node_modules/
demo/jeecg/app-b/node_modules/
demo/jeecg/app-a/dist/
demo/jeecg/app-b/dist/
demo/jeecg/app-*/stats.html
# 浏览器验收截图仅保留本地（公开仓库不带业务截图）
evidence/
demo/jeecg/pnpm-lock.yaml

# templates: 依赖目录不入库（锁文件与源码入库）
templates/**/node_modules/
