{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "vite": [
        "./node_modules/vite"
      ],
      "vue": [
        "./node_modules/vue"
      ],
      "vue-router": [
        "./node_modules/vue-router"
      ]
    }
  },
  "include": [
    "src",
    "fulgurjs.config.ts",
    "vite.config.ts"
  ]
}
